# Required. At least 32 characters. The app refuses to boot without it.
BETTER_AUTH_SECRET=

# Optional. Defaults to 3000.
PORT=3000

# Optional SQLite file. Defaults to auth.sqlite. Use :memory: for a throwaway database.
DB_FILE=auth.sqlite

# Optional SMTP. When SMTP_HOST is empty, OTP codes are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
